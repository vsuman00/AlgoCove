# AlgoCove environment example.
#
# Copy to `.env` for local development. `.env` is git-ignored and must never be
# committed. Every variable below is parsed and validated at process start by
# `@algocove/config`; a missing or invalid required value fails closed with a
# stable reason code instead of starting in an undefined state.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Stable service identifier used in structured logs and correlation headers.
# Required. Allowed: ^[a-z][a-z0-9-]{1,31}$
SERVICE_NAME=algocove-web

# Log level for structured application logs. debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web application
# ---------------------------------------------------------------------------

# Public origin used to build absolute links. Required in production.
# Local default: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Virtual (host) port for the local development server.
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL (source of truth, pgvector enabled)
# ---------------------------------------------------------------------------

# Administrative connection used only by migration and role-bootstrap commands.
# Never granted to the running application. Optional locally; required to run
# `pnpm db:roles` and `pnpm db:migrate`.
DATABASE_ADMIN_URL=postgres://algocove_admin:algocove_admin@localhost:54329/algocove

# Runtime connection for the application and integration tests. It carries the
# non-owner role, so it cannot run DDL or bypass schema ownership.
DATABASE_URL=postgres://algocove_app:algocove_app@localhost:54329/algocove

# Connection pool ceiling. 1..64
DATABASE_POOL_MAX=10

# Statement timeout applied to every runtime connection, in milliseconds. 100..60000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Feature availability (Phase 1 baseline; advanced capabilities stay disabled)
# ---------------------------------------------------------------------------

# AI tutor generation. Must remain false until budgets, redaction, and
# evaluation exist (implementation plan Task 51 before live AI).
TUTOR_ENABLED=false

# Isolated code execution. Must remain false until the sandbox is approved
# (implementation plan Tasks 19-24).
EXECUTION_ENABLED=false

# Local identity adapter for development and tests only. Hosted identity
# replaces this before the pilot (implementation plan Task 55a).
LOCAL_IDENTITY_ENABLED=true