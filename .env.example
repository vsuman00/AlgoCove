# AlgoCove environment example.
#
# Copy to `.env` for local development. `.env` is git-ignored and must never be
# committed. Every variable below is parsed and validated at process start by
# `@algocove/config`; a missing or invalid required value fails closed with a
# stable reason code instead of starting in an undefined state.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Stable service identifier used in structured logs and correlation headers.
# Required. Allowed: ^[a-z][a-z0-9-]{1,31}$
SERVICE_NAME=algocove-web

# Log level for structured application logs. debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web application
# ---------------------------------------------------------------------------

# Public origin used to build absolute links. Required in production.
# Local default: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Virtual (host) port for the local development server.
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL (source of truth, pgvector enabled)
# ---------------------------------------------------------------------------

# Operator connection used only by the first role-bootstrap command. It must
# have CREATEROLE and CREATE EXTENSION privileges and is never used by the web
# runtime. Keep this separate from the migration role connection below.
DATABASE_OPERATOR_URL=postgres://postgres:postgres@localhost:54329/algocove

# Migration/schema-owner connection used only by `pnpm db:migrate`. The role is
# created by `pnpm db:roles` and is never granted to the running application.
DATABASE_ADMIN_URL=postgres://algocove_admin:algocove_admin@localhost:54329/algocove

# Runtime connection for the application and integration tests. It carries the
# non-owner role, so it cannot run DDL or bypass schema ownership.
DATABASE_URL=postgres://algocove_app:algocove_app@localhost:54329/algocove

# Connection pool ceiling. 1..64
DATABASE_POOL_MAX=10

# Statement timeout applied to every runtime connection, in milliseconds. 100..60000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Feature availability (Phase 1 baseline; advanced capabilities stay disabled)
# ---------------------------------------------------------------------------

# AI tutor generation. Must remain false until budgets, redaction, and
# evaluation exist (implementation plan Task 51 before live AI).
TUTOR_ENABLED=false

# Isolated code execution. Must remain false until the sandbox is approved
# (implementation plan Tasks 19-24).
EXECUTION_ENABLED=false

# Internal execution relay. Both values are required together, and production
# execution refuses to start without them. The relay owns descriptor creation,
# admission, ephemeral source delivery, and cancellation; learner source must
# never appear in the durable preparation response.
# Leave these unset while the approved relay is unavailable. Set both together
# only for a real internal relay deployment.
# EXECUTION_RELAY_URL=https://execution-relay.example
# EXECUTION_RELAY_TOKEN=<server-only-secret>

# Server-only token used by the execution worker when posting signed terminal
# results back to the authenticated internal callback route.
# Set this only when the execution worker is deployed and can authenticate the
# signed-result callback. Keep it server-only.
# EXECUTION_RESULT_CALLBACK_TOKEN=<server-only-secret>

# Clerk authentication. Both values are required together in production.
# Leave unset for public shell/build checks; protected routes return unauthenticated
# until a Clerk application is configured.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
