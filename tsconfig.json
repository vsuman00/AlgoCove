{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "services/*/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/test-real-learning-loop.ts"
  ],
  "exclude": ["**/node_modules", "apps/web/.next", "tests/architecture/fixtures"]
}
